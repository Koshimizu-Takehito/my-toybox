### https://raw.github.com/github/gitignore/8779ee73af62c669e7ca371aaab8399d87127693/Global/Xcode.gitignore

## User settings
xcuserdata/
.DS_Store

# Xcode app build output (project-relative build folder)
App/build/

# Xcode SPM scheme files (auto-generated)
Packages/.swiftpm/
MetadatasMacros/.swiftpm/
ScreenMacros/.swiftpm/

# Compiled Metal library (generated by SPM plugin or build_metallib.sh; not committed)
*.metallib

# ============================================================================
# App Store Connect / fastlane metadata management
# ============================================================================

# Local environment variables (ASC_KEY_ID, ASC_ISSUER_ID, ...). Use .env.template as a starting point.
.env
.env.local

# App Store Connect API key (.p8) - MUST never be committed
fastlane/AuthKey_*.p8

# Generated artifacts
fastlane/screenshots/screenshots.html
fastlane/Preview.html
fastlane/report.xml

# Override the default fastlane gitignore: we DO version-control screenshots
# and preview videos so the App Store presentation is reviewable via PR.
!fastlane/screenshots/**/*.png
!fastlane/screenshots/**/*.jpg
!fastlane/screenshots/**/*.jpeg
!fastlane/screenshots/**/*.mp4
!fastlane/screenshots/**/*.mov

# Bundler cache (created by `bundle install --path vendor/bundle`)
vendor/bundle/
.bundle/
