# Local environment variables for App Store Connect / fastlane.
#
# Usage:
#   1. Copy to `.env` (which is gitignored):
#        cp .env.template .env
#   2. Fill in the real values from App Store Connect →
#      Users and Access → Integrations → Keys.
#   3. Place the corresponding `.p8` file at `fastlane/AuthKey_<KEYID>.p8`.
#
# `make` automatically loads `.env` if present, so any `make metadata-*`
# target picks these up without manual `export`.

ASC_KEY_ID=
ASC_ISSUER_ID=
