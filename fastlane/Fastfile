require File.expand_path("asc_helper", __dir__)

default_platform(:ios)

platform :ios do
  before_all do
    key_path = ENV["ASC_KEY_PATH"] || Dir[File.expand_path("AuthKey_*.p8", __dir__)].first
    UI.user_error!("ASC API key (.p8) not found under fastlane/. Set ASC_KEY_PATH or place AuthKey_*.p8 there.") if key_path.nil?
    UI.user_error!("ASC_KEY_ID is not set.") if ENV["ASC_KEY_ID"].to_s.empty?
    UI.user_error!("ASC_ISSUER_ID is not set.") if ENV["ASC_ISSUER_ID"].to_s.empty?

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: key_path,
      in_house: false,
    )
  end

  desc "Download current metadata and screenshots from App Store Connect"
  lane :pull do
    require "json"
    require "tmpdir"

    # `deliver download_metadata` / `download_screenshots` are CLI subcommands that
    # spawn a fresh Ruby process, so the API key set in `before_all` doesn't carry
    # over. Materialize it into a temporary JSON file and hand it to the child
    # process via `--api_key_path`.
    key_path = ENV["ASC_KEY_PATH"] || Dir[File.expand_path("AuthKey_*.p8", __dir__)].first

    Dir.mktmpdir do |tmp|
      json_path = File.join(tmp, "asc_api_key.json")
      File.write(json_path, JSON.generate(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key: File.read(key_path),
        duration: 1200,
        in_house: false,
      ))
      sh("cd .. && bundle exec fastlane deliver download_metadata --force --api_key_path '#{json_path}'")
      sh("cd .. && bundle exec fastlane deliver download_screenshots --force --api_key_path '#{json_path}'")
    end
  end

  desc "Upload metadata, screenshots, and release notes (no binary)"
  desc "Pass `version:` to create that App Store version on ASC if it doesn't exist yet"
  lane :push do |options|
    # Shared deliver options (force, no binary, precheck, manual release) live in the Deliverfile.
    deliver(
      app_version: options[:version],
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: false,
    )
  end

  desc "Check submission prerequisites (age rating, App Clip default experience) without changing ASC"
  desc "Usage: fastlane submit_review_preflight version:1.3.0"
  lane :submit_review_preflight do |options|
    UI.user_error!("Pass `version:` (e.g. 1.3.0).") if options[:version].to_s.empty?

    app_id = ASCHelper.app_id
    ASCHelper.warn_unanswered_age_rating(app_id: app_id)
    ASCHelper.ensure_app_clip_default_experience!(app_id: app_id, version_string: options[:version].to_s, dry_run: true)
  end

  desc "Attach an uploaded build (e.g. from Xcode Cloud) to the version and submit it for review"
  desc "Copies the previous App Clip default experience if needed and explains ASC's rejection reasons"
  desc "Usage: fastlane submit_review version:1.3.0 build:63"
  lane :submit_review do |options|
    UI.user_error!("Pass `version:` (e.g. 1.3.0).") if options[:version].to_s.empty?
    UI.user_error!("Pass `build:` (the build number uploaded by Xcode Cloud).") if options[:build].to_s.empty?

    version = options[:version].to_s
    app_id = ASCHelper.app_id
    ASCHelper.warn_unanswered_age_rating(app_id: app_id)
    ASCHelper.ensure_app_clip_default_experience!(app_id: app_id, version_string: version)

    begin
      deliver(
        app_version: version,
        build_number: options[:build].to_s,
        skip_metadata: true,
        skip_screenshots: true,
        submit_for_review: true,
        submission_information: {
          add_id_info_uses_idfa: false,
        },
      )
    rescue Spaceship::UnexpectedResponse
      # ASC rejected an API call (e.g. the review item); show its per-field reasons.
      ASCHelper.explain_review_submission_errors(app_id: app_id, version_string: version)
      raise
    end
  end

  desc "Validate local metadata without uploading"
  lane :precheck_metadata do
    precheck(
      include_in_app_purchases: false,
    )
  end
end
